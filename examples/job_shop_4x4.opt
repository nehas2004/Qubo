# 4-Job 4-TimeSlot Job Shop Scheduling
#
# 4 jobs must each be assigned to exactly one of 4 time slots.
# Only one job can run per slot (machine capacity = 1).
# Objective: minimize total weighted completion time (earlier = lower cost).
#
# Variables: x[job*4 + slot]
#   x[0..3]  : Job A at slots 0,1,2,3
#   x[4..7]  : Job B at slots 0,1,2,3
#   x[8..11] : Job C at slots 0,1,2,3
#   x[12..15]: Job D at slots 0,1,2,3
#
# Weight: slot 0 costs 1, slot 1 costs 2, slot 2 costs 3, slot 3 costs 4.

PROBLEM: JobShop4x4

VARIABLES:
    binary x[16]

OBJECTIVE:
    MINIMIZE  1*x[0]  + 2*x[1]  + 3*x[2]  + 4*x[3]
            + 1*x[4]  + 2*x[5]  + 3*x[6]  + 4*x[7]
            + 1*x[8]  + 2*x[9]  + 3*x[10] + 4*x[11]
            + 1*x[12] + 2*x[13] + 3*x[14] + 4*x[15]

CONSTRAINTS:
    # Each job assigned to exactly one slot
    jobA: x[0]  + x[1]  + x[2]  + x[3]  == 1
    jobB: x[4]  + x[5]  + x[6]  + x[7]  == 1
    jobC: x[8]  + x[9]  + x[10] + x[11] == 1
    jobD: x[12] + x[13] + x[14] + x[15] == 1

    # At most one job per slot
    slot0: x[0] + x[4] + x[8]  + x[12] <= 1
    slot1: x[1] + x[5] + x[9]  + x[13] <= 1
    slot2: x[2] + x[6] + x[10] + x[14] <= 1
    slot3: x[3] + x[7] + x[11] + x[15] <= 1
