      + x[7]  + x[9]  - 2*x[7]*x[9]
      + x[7]  + x[10] - 2*x[7]*x[10]
      + x[7]  + x[12] - 2*x[7]*x[12]
      + x[7]  + x[13] - 2*x[7]*x[13]
      + x[8]  + x[10] - 2*x[8]*x[10]
